# Bright Data Web Unlocker — required for a LIVE run only.
# The test suite runs offline against a committed corpus and needs none of this.
BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=

# Where a live run journals its progress and caches responses. Both are gitignored:
# a run must survive a crash or a rate-limit stall without losing paid requests.
RESOLUTION_RUN_DIR=./runs
RESOLUTION_CACHE_DIR=./captures
